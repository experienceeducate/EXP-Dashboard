# ── Copy to backend/.env and fill in. backend/.env is gitignored. ──
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# BigQuery
# Path to a service-account JSON key. How every deploy runs (k8s mounts it at
# /var/secrets/gcp/key.json). LEAVE EMPTY for local dev and instead run
#   gcloud auth application-default login
# to reach BigQuery as your own Google identity — that keeps a long-lived SA
# key off developer laptops. A value here always takes precedence over ADC.
GOOGLE_SERVICE_ACCOUNT_KEY=
BQ_PROJECT_ID=educate-data-warehouse-test
BQ_DATASET=gold_exp
BQ_TABLE=exp_ai_dashboard_model

# Auth (REQUIRED — app fails to boot without these)
JWT_SECRET=change-me-generate-a-64-hex-secret
# Signs the OAuth state cookie only. Leave blank locally (a key is derived
# from JWT_SECRET for that one purpose); set its own value in production.
SESSION_SECRET=

# Google OAuth — the primary sign-in path. Create a "Web application" OAuth
# client (see README → Google OAuth setup) and register the redirect URI:
#   http://localhost:8000/api/auth/google/callback   (local)
#   https://exp-dashboard-api.<domain>/api/auth/google/callback  (prod)
# Staff sign in ONLY with Google (the shared-password login was removed in the
# security review), so set these for local dev too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_DOMAIN=experienceeducate.org

# Access control (optional; falls back to core/access.py fallback if unset)
ACCESS_CONFIG_PATH=

# Client-header guard
CLIENT_HEADER_NAME=X-Exp-Client
CLIENT_HEADER_TOKEN=dashboard-v1

# URLs / CORS
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=

# Cache
CACHE_MAXSIZE=512
CACHE_TTL_SECONDS=300

# ── Sessions & guest access (security review DATA-894) ──
SESSION_IDLE_MINUTES=60
STAFF_SESSION_HOURS=8
GUEST_SESSION_HOURS=8
# Keep the access event log in memory (local dev / tests only — lost on restart).
# Unset in production: events go to <BQ_PROJECT_ID>.<DASHBOARD_APP_DATASET>.raw_exp_dashboard_access_events.
ACCESS_EVENTS_IN_MEMORY=true
# Sign-in link mail: "smtp", "file" (writes .eml files to MAIL_OUTBOX_DIR — local dev),
# or blank/"disabled" (guest sign-in unavailable).
MAIL_BACKEND=file
MAIL_OUTBOX_DIR=./outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Interactive API docs (/docs). Never enable in production.
ENABLE_API_DOCS=false
# Optional read-only service-account key for E!nsight's generated SQL.
ENSIGHT_GOOGLE_SERVICE_ACCOUNT_KEY=
