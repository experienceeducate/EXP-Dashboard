# ── Copy to backend/.env and fill in. backend/.env is gitignored. ──
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# BigQuery
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
BQ_PROJECT_ID=educate-data-warehouse-test
BQ_DATASET=gold_exp
BQ_TABLE=exp_ai_dashboard_model

# Auth (REQUIRED — app fails to boot without these)
JWT_SECRET=change-me-generate-a-64-hex-secret
# Shared password for the hidden fallback login path (still required to boot).
DASHBOARD_PASSWORD=change-me

# Google OAuth — the primary sign-in path. Create a "Web application" OAuth
# client (see README → Google OAuth setup) and register the redirect URI:
#   http://localhost:8000/api/auth/google/callback   (local)
#   https://exp-dashboard-api.<domain>/api/auth/google/callback  (prod)
# Optional locally: leave blank to use only the password fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_DOMAIN=experienceeducate.org

# Access control (optional; falls back to core/access.py fallback if unset)
ACCESS_CONFIG_PATH=

# Client-header guard
CLIENT_HEADER_NAME=X-Exp-Client
CLIENT_HEADER_TOKEN=dashboard-v1

# URLs / CORS
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=

# Cache
CACHE_MAXSIZE=512
CACHE_TTL_SECONDS=300

# Weekly digest (all optional — each piece no-ops individually if unset, see
# app/routers/digest.py). DIGEST_INTERNAL_TOKEN gates POST /internal/digest/run
# (called by .github/workflows/weekly-digest.yml, not a browser) — generate one
# the same way as JWT_SECRET and put it in both this file and the GitHub Actions
# secret DIGEST_INTERNAL_TOKEN.
DIGEST_INTERNAL_TOKEN=
# Dataset the digest reads/writes its own snapshot table in — see
# DATA_ENG_BIGQUERY_TABLES_REQUEST.md (table 3). Requires bigquery.dataEditor.
DASHBOARD_APP_DATASET=dashboard_app
# Narrative generation goes through OpenRouter (OpenAI-compatible API), targeting
# Claude via OpenRouter's model slug. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Google Workspace SMTP — a mailbox + app password (Google Account → Security →
# App passwords) works with smtp.gmail.com:587 without any relay allowlisting.
DIGEST_SMTP_HOST=smtp.gmail.com
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USERNAME=
DIGEST_SMTP_PASSWORD=
DIGEST_FROM_EMAIL=
